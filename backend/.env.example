# Backend Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jojos_news
DB_USER=postgres
DB_PASSWORD=postgres

# Twitter/X API
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here

# Summarization LLM provider: "gemini" (cloud, free tier) or "ollama" (local).
# If unset, the app auto-selects gemini when GEMINI_API_KEY is present, else ollama.
LLM_PROVIDER=gemini

# Google Gemini (free tier) - get a key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# 'gemini-flash-latest' is a self-updating alias to the current free flash model.
GEMINI_MODEL=gemini-flash-latest

# Ollama (local fallback; only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Resend Email
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@example.com
EMAIL_TO=your-email@example.com

# Scheduling
# Email: Send at 6 AM CET daily (cron format)
EMAIL_SEND_TIME=0 6 * * *
EMAIL_TIMEZONE=Europe/Berlin

# News Aggregation: Every 6 hours (00:00, 06:00, 12:00, 18:00)
AGGREGATION_SCHEDULE=0 */6 * * *

# Summarization: 5 AM daily (one hour before email send)
SUMMARIZATION_SCHEDULE=0 5 * * *

# News Source Configuration
NEWS_SOURCES=rss,twitter,reddit
RSS_FEEDS_URL=https://example.com/feeds.json

# Feature Flags
ENABLE_TWITTER_FEED=true
ENABLE_RSS_FEED=true
ENABLE_REDDIT_FEED=true
DRY_RUN_EMAIL=false
