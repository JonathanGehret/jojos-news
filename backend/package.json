{
  "name": "jojos-news-backend",
  "version": "1.0.0",
  "description": "AI-powered daily news ticker with email delivery",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "task": "ts-node --transpile-only src/tasks/run.ts",
    "task:digest": "ts-node --transpile-only src/tasks/run.ts digest"
  },
  "keywords": [
    "news",
    "aggregator",
    "email",
    "ollama",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.2",
    "pg": "^8.11.1",
    "resend": "^0.17.0",
    "uuid": "^9.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.4",
    "@types/pg": "^8.20.0",
    "@types/xml2js": "^0.4.14",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
